# Build artifacts
/target
**/target/

# Coverage and profiling
coverage/
*.profraw
*.profdata
*.gcda
*.gcno
*.lcov

# Editor and OS noise
.DS_Store
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# Logs and temp files
*.log
*.tmp

# Generated wrapup reports (local artifacts)
export/wrapup_*.html
export/wrapup_*.json
!export/wrapup_2025.json

# Secrets and local overrides
.env
.env.*
!.env.example
!.env.sample

# Local Contrail data (keeps personal logs/memories out of commits)
.contrail/

# Beads runtime state is local, but keep the small config/export files
# versioned so bd can sync issue state without forcing ignored files.
/.beads/*
!/.beads/.gitignore
!/.beads/README.md
!/.beads/config.yaml
!/.beads/metadata.json
!/.beads/issues.jsonl
# Local IDE/assistant/session metadata (tooling state, not project source)
/.codex
/.context
/.cursor
# memex: raw sessions gitignored (vault.age is committed instead)
.context/sessions/*.md
.context/LEARNINGS.md
# Rust formatter backups
**/*.rs.bk

# Dolt database files (added by bd init)
.dolt/
*.db

# Beads / Dolt files (added by bd init)
.beads-credential-key
